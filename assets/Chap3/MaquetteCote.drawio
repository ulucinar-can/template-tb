        <mxCell id="3CdW1dLSNoq6S-vy_8aO-3" parent="1" style="ellipse;whiteSpace=wrap;html=1;" value="&lt;div&gt;Etat 1&lt;/div&gt;&lt;div&gt;Rampe de courant&lt;/div&gt;&lt;div&gt;juqu&#39;à 3A&lt;/div&gt;&lt;div&gt;pour l&#39;inducteur 1&amp;amp;2&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="140" x="950" y="-910" as="geometry" />
        </mxCell>
        <mxCell id="3CdW1dLSNoq6S-vy_8aO-9" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div align=&quot;center&quot;&gt;current1 &amp;lt; 3A&lt;/div&gt;&lt;div align=&quot;center&quot;&gt;&amp;amp;&amp;amp;&amp;nbsp;&lt;/div&gt;&lt;div align=&quot;center&quot;&gt;current2 &amp;lt; 3A&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="100" x="1040" y="-980" as="geometry" />
        </mxCell>
        <mxCell id="3CdW1dLSNoq6S-vy_8aO-11" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div align=&quot;left&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;span data-teams=&quot;true&quot;&gt;&lt;p&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;Le décollage à 4 inducteurs est censé se dérouler de la manière suivante :&lt;/font&gt;&lt;/p&gt;&lt;p&gt;Etat 0 : On attends la pression du boutton&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;Etat 1 : On monte le courant des inducteurs 1&amp;amp;2 à 3 A (pour ne pas partir de zéro).&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;Etat 2 : On augmente le courant des inducteurs 1&amp;amp;2 avec une rampe &quot;infinie&quot; (régulation de courant seule).&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;Etat 3 : Lorsque l&#39;inducteur 1&amp;amp;2 commencent à bouger, on les passe en régulation de position (lévitation de l&#39;avant du véhicule).&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;Etat 4 :&lt;/font&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;span data-teams=&quot;true&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt; On monte le courant des inducteurs 3&amp;amp;4 à 3 A (pour ne pas partir de zéro).&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;Etat 5 : On augmente le courant des inducteurs 3 et 4 avec une rampe (régulation de courant seule).&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;Etat 6 : Lorsque l&#39;inducteur 3&amp;amp;4 commencent à bouger, on les passe en régulation de position (lévitation de l&#39;arrière du véhicule, l&#39;avant lévite déjà).&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;Etat 7 : On change les gains statiques pour une régulation plus douce et on passe à une régulation de maintien&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;Etat 8 : On arrête la sustentation et rénintialise les variables&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;Etat 9 : On affiche un message d&#39;erreur si la maquette rencontre un problème&lt;/font&gt;&lt;/p&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="561.54" width="570" x="1690" y="-1121.54" as="geometry" />
        </mxCell>
        <mxCell id="3CdW1dLSNoq6S-vy_8aO-12" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div&gt;Position1 &amp;gt;= 2.97&lt;/div&gt;&lt;div&gt;&amp;amp;&amp;amp;&lt;/div&gt;&lt;div&gt;&lt;div&gt;Position2 &amp;gt;= 2.97&lt;/div&gt;&lt;/div&gt;" vertex="1">
